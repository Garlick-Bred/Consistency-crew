{
  "name": "consistency-crew",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-27",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "consistency-crew-db",
      "database_id": "c366751c-fcec-4812-815d-91efc36d62dc",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
